{
  "name": "mgmusic-plugin",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "咪咕音乐金币中心 JS 插件（QuickJS / Node）",
  "scripts": {
    "check": "node scripts/check-phone-leak.mjs && npm run check:types && npm run typecheck && npm test",
    "check:link": "node scripts/check-link.mjs",
    "pack": "node scripts/pack-panelllrt.mjs",
    "build:panelllrt": "node scripts/build-panelllrt.mjs",
    "deploy:panel": "bash scripts/deploy-panel.sh",
    "test:config": "node scripts/test-config.mjs",
    "check:types": "node scripts/sync-types.mjs --check",
    "typecheck": "node scripts/typecheck.mjs && npm run typecheck:node",
    "test": "npm run check:src && npm run check:cli && npm run test:config",
    "typecheck:node": "node scripts/typecheck-node.mjs",
    "build": "node scripts/build-panelllrt.mjs",
    "check:src": "node --check src/mgmusic.js && node --check src/webui/app.js",
    "cli": "node src/cli.mjs",
    "check:cli": "node scripts/check-cli.mjs"
  },
  "bin": {
    "mgmusic": "./src/cli.mjs"
  }
}
